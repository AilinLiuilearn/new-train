# -*- coding: utf-8 -*-
import os
import torch
import torch.nn.functional as F
from utils.loss_seg import DiceBCELoss
from utils.metrics_seg import SegmentationMetricsCIPA
from utils.optimization import get_optimizer


def _forward(nets, ct, pet, target_size):
    feats_ct  = nets["enc_ct" ](ct,  return_list=True)
    feats_pet = nets["enc_pet"](pet, return_list=True)

    # --- 新增正则化：对所有尺度的骨干特征进行通道丢弃 ---
    feats_ct  = [nets["feature_dropout"](f) for f in feats_ct]
    feats_pet = [nets["feature_dropout"](f) for f in feats_pet]

    fused = [nets[f"fuse_{i}"](feats_ct[i], feats_pet[i]) for i in range(4)]
    return nets["segmentor"](fused, target_size=target_size)


def _decouple_losses(nets, ct, alpha_orth=0.1, alpha_adv=0.05):
    """
    计算深层 (fuse_2, fuse_3) 的对抗解耦复合损失：
      L_orth     : cosine 相似度绝对值，强迫 shared / specific 正交
      L_adv_recon: 惩罚 specific 能还原 CT 的程度（重构误差越大越好）
    """
    loss_orth = ct.new_zeros(1).squeeze()
    loss_adv  = ct.new_zeros(1).squeeze()
    B = ct.size(0)

    for i in [2, 3]:
        layer = nets[f"fuse_{i}"]
        if layer.last_shared is None:
            continue

        sim = F.cosine_similarity(
            layer.last_shared.reshape(B, -1),
            layer.last_specific.reshape(B, -1),
            dim=1,
        )
        loss_orth = loss_orth + torch.mean(torch.abs(sim))

        target_ct = F.interpolate(
            ct, size=layer.last_recon_ct.shape[2:], mode='bilinear', align_corners=True
        )
        target_ct_norm = (target_ct - target_ct.amin(dim=(1, 2, 3), keepdim=True)) / (
            target_ct.amax(dim=(1, 2, 3), keepdim=True)
            - target_ct.amin(dim=(1, 2, 3), keepdim=True) + 1e-6
        )
        recon_mse = F.mse_loss(layer.last_recon_ct, target_ct_norm)
        loss_adv  = loss_adv + torch.clamp(1.0 - recon_mse, min=0.0)

    return alpha_orth * loss_orth, alpha_adv * loss_adv


class MDTSegTeacher:
    def __init__(self, networks, config):
        self.networks = {k: v for k, v in networks.items() if v is not None}
        self.config   = config
        self.device   = torch.device("cuda", int(config.gpus[0]))
        for v in self.networks.values():
            v.to(self.device)
        self.optimizer = None
        self.scheduler = None
        self.scaler = torch.amp.GradScaler("cuda") if config.mixed_precision else None
        self.loss_seg = DiceBCELoss(
            smooth=getattr(config, "dice_smooth", 1.0),
            pos_weight=getattr(config, "pos_weight", None),
            bce_weight=getattr(config, "bce_weight", 1.0),
            dice_weight=getattr(config, "dice_weight", 1.0),
        ).to(self.device)
        self.alpha_orth = getattr(config, "alpha_orth", 0.1)
        self.alpha_adv  = getattr(config, "alpha_adv_recon", 0.05)
        params = [{"params": v.parameters()} for v in self.networks.values()]
        self.optimizer = get_optimizer(
            params, config.optimizer, config.learning_rate, config.weight_decay
        )

    def train_step(self, batch, alpha_orth=None, alpha_adv=None):
        ct   = batch["ct"].float().to(self.device)
        pet  = batch["pet"].float().to(self.device)
        mask = batch["mask"].float().to(self.device)

        # 支持外部传入动态 alpha（用于衰减），默认使用初始化时的值
        cur_orth = alpha_orth if alpha_orth is not None else self.alpha_orth
        cur_adv  = alpha_adv  if alpha_adv  is not None else self.alpha_adv

        logit = _forward(self.networks, ct, pet, mask.shape[-2:])
        loss_seg = self.loss_seg(logit, mask)

        loss_orth, loss_adv = _decouple_losses(
            self.networks, ct, cur_orth, cur_adv
        )
        total_loss = loss_seg + loss_orth + loss_adv

        loss_dict = {
            "loss_seg":  loss_seg.detach(),
            "loss_orth": loss_orth.detach(),
            "loss_adv":  loss_adv.detach(),
        }
        return total_loss, logit, mask, loss_dict

    @torch.no_grad()
    def evaluate(self, loader, threshold=None):
        for v in self.networks.values():
            v.eval()
        th = threshold or getattr(self.config, "eval_threshold", 0.5)
        m = SegmentationMetricsCIPA(threshold=th).to(self.device)
        m.reset()
        total_loss, n = 0.0, 0
        for batch in loader:
            ct   = batch["ct"].float().to(self.device)
            pet  = batch["pet"].float().to(self.device)
            mask = batch["mask"].float().to(self.device)
            logit = _forward(self.networks, ct, pet, mask.shape[-2:])
            total_loss += self.loss_seg(logit, mask).item() * ct.size(0)
            n += ct.size(0)
            m.update(logit, mask)
        for v in self.networks.values():
            v.train()
        out = m.compute()
        out["total_loss"] = total_loss / max(n, 1)
        return out

    @torch.no_grad()
    def collect_logits_targets(self, loader):
        for v in self.networks.values():
            v.eval()
        logits, targets = [], []
        for batch in loader:
            ct   = batch["ct"].float().to(self.device)
            pet  = batch["pet"].float().to(self.device)
            mask = batch["mask"].float().to(self.device)
            logits.append(_forward(self.networks, ct, pet, mask.shape[-2:]).cpu())
            targets.append(mask.cpu())
        for v in self.networks.values():
            v.train()
        return torch.cat(logits), torch.cat(targets)

    def save_checkpoint(self, path, epoch):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        ckpt = {k: v.state_dict() for k, v in self.networks.items()}
        ckpt["epoch"] = epoch
        ckpt["optimizer"] = self.optimizer.state_dict()
        torch.save(ckpt, path)
        print("Saved:", path)
