+def test_real_runner_fusion_resume_and_evaluate(tmp_path, monkeypatch):
+    from test_staged import make_pngs
+    root=tmp_path/'data'; root.mkdir(); make_pngs(root,train=2)
+    output=tmp_path/'joint'
